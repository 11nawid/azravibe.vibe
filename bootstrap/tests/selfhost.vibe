note: Verifies the self-hosting fixed point entirely in Azra.
note: The compiler is split into small maintainable modules; this test
note: concatenates them into one source for the fixed-point check.
use "../compiler.vibe"
use "../vm.vibe"

set files to "bootstrap/core.vibe", "bootstrap/parser.vibe", "bootstrap/emit.vibe", "bootstrap/compile_block.vibe", "bootstrap/compiler.vibe"
set combined to ""
for each f in files:
    set part to read file f
    set combined to combined + part + "\n"
write combined to file "bootstrap/tests/combined.vibe"
set g1 to compile_source with combined

set driver to read file "bootstrap/tests/selfhost_driver.vibe"
set bootstrap to compile_source with combined + "\n" + driver
execute with bootstrap
set g2 to parse json read file "bootstrap/tests/gen2.json"

assert equals length of g1, length of g2
set bad to 0
repeat with i from 1 to length of g1:
    if to json item i of g1 not_equals to json item i of g2:
        add 1 to bad
assert equals bad, 0

say "self-host fixed point passed:", length of g1, "instructions"
