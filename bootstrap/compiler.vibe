use "core.vibe"
use "parser.vibe"
use "emit.vibe"
use "compile_block.vibe"
note: compiler.vibe — program compiler entry point, written in Azra.

define shift_code with code, delta:
    for each ins in code:
        set op to key "op" of ins
        if op equals "jf" or op equals "jmp":
            set a to key "arg" of ins
            add delta to a
            set key "arg" of ins to a

define function_end with lines, start:
    set j to start + 1
    while j less_than= length of lines:
        set l to item j of lines
        set ind to key "indent" of l
        if ind equals 0:
            stop loop
        add 1 to j
    give back j

define compile_source with source:
    set lines to tokenize_source with source
    set main_lines to empty list
    set pending to empty list
    set i to 1
    while i less_than= length of lines:
        set ln to item i of lines
        set ws to key "words" of ln
        set is_def to false
        if length of ws greater_than 0:
            set h to item 1 of ws
            if h equals "define" and key "indent" of ln equals 0:
                set is_def to true
        if is_def equals true:
            set params to empty list
            if length of ws greater_than 3:
                repeat with k from 4 to length of ws:
                    add item k of ws to params
            set info to empty map
            set key "name" of info to item 2 of ws
            set key "params" of info to params
            set key "start" of info to i + 1
            set end_index to function_end with lines, i + 1
            set key "end" of info to end_index - 1
            add info to pending
            set i to end_index
            skip next
        add ln to main_lines
        add 1 to i

    set whole to compile_block with main_lines, 1, 0, 0
    set main_code to key "code" of whole
    set fn_section to empty list
    set defs to empty list
    for each fn in pending:
        set addr to length of main_code + length of fn_section + 1
        set d to empty map
        set key "name" of d to key "name" of fn
        set key "params" of d to key "params" of fn
        set key "addr" of d to addr
        add d to defs
        set fcomp to compile_block with lines, key "start" of fn, 4, length of main_code + length of fn_section + 1
        set fcode to key "code" of fcomp
        for each ins in fcode:
            add ins to fn_section
        emit_op with fn_section, "ret"

    set prologue to empty list
    for each d in defs:
        set ins to empty map
        set key "op" of ins to "funcdef"
        set key "arg" of ins to key "name" of d
        set key "params" of ins to key "params" of d
        set a to key "addr" of d
        add length of defs + 1 to a
        set key "addr" of ins to a
        add ins to prologue

    set shift to length of defs
    shift_code with main_code, shift
    shift_code with fn_section, shift
    emit_arg with main_code, "jmp", 0
    set endjump_index to length of main_code
    set target to length of prologue + length of main_code + length of fn_section + 1
    patch_arg with main_code, endjump_index, target

    set final to empty list
    for each ins in prologue:
        add ins to final
    for each ins in main_code:
        add ins to final
    for each ins in fn_section:
        add ins to final
    give back final
