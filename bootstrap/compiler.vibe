note: bootstrap/compiler.vibe — Azra compiler written in Azra.
note: Round 1: calls, builtins, collections, user functions, control flow.

set loop_depth to 0
set loop_stack to empty list

define push_loop with start_at:
    set f to empty map
    set key "start" of f to start_at
    set key "continue" of f to start_at
    set key "breaks" of f to empty list
    set key "continues" of f to empty list
    add f to loop_stack

define current_loop:
    set n to length of loop_stack
    give back item n of loop_stack

define pop_loop:
    set n to length of loop_stack
    set f to item n of loop_stack
    remove item n from loop_stack
    give back f

define is_digit_start with t:
    set cs to split t by ""
    if length of cs equals 0:
        give back false
    set first to item 1 of cs
    if first equals "-":
        if length of cs less_than 2:
            give back false
        set first to item 2 of cs
    set digits to split "0123456789" by ""
    for each d in digits:
        if first equals d:
            give back true
    give back false

define is_quoted with t:
    if t starts with "\"":
        give back true
    give back false

define is_comment with t:
    if t starts with "#":
        give back true
    if t starts with "note:":
        give back true
    give back false

define strip_colon with t:
    set quoted to is_quoted with t
    if quoted equals true:
        give back t
    set parts to split t by ":"
    if length of parts less_than 2:
        give back t
    give back item 1 of parts

define is_separator with ch, in_string:
    if in_string equals true:
        give back false
    if ch equals " ":
        give back true
    if ch equals ",":
        give back true
    give back false

define tokenize_line with raw:
    set indent to 0
    set chars_list to split raw by ""
    for each ch in chars_list:
        set sp to ch equals " "
        if sp equals false:
            stop loop
        add 1 to indent

    set words to empty list
    set current to ""
    set in_string to false
    set prev to ""
    for each ch in chars_list:
        set is_quote to ch equals "\""
        if prev equals "\\":
            set is_quote to false
        set prev to ch
        if is_quote equals true:
            set in_string to not in_string
            set current to current + ch
            skip next
        set sep to is_separator with ch, in_string
        if sep equals false:
            set current to current + ch
            skip next
        if length of current equals 0:
            skip next
        set commented to is_comment with current
        if commented equals true:
            stop loop
        set fixed to strip_colon with current
        add fixed to words
        set current to ""

    if length of current greater_than 0:
        set commented to is_comment with current
        if commented equals false:
            set fixed to strip_colon with current
            add fixed to words

    set info to empty map
    set key "indent" of info to indent
    set key "words" of info to words
    give back info

define tokenize_source with source:
    set result to empty list
    set raw_lines to split source by "\n"
    for each raw in raw_lines:
        set info to tokenize_line with raw
        add info to result
    give back result

define peek with words, pos:
    if pos greater_than length of words:
        give back ""
    give back item pos of words

define unquote with t:
    set cs to split t by ""
    if length of cs less_than 2:
        give back t
    set last_at to length of cs - 1
    set inner to ""
    repeat with i from 2 to last_at:
        set inner to inner + item i of cs
    set out to ""
    set pending to false
    for each c in split inner by "":
        if pending equals true:
            set mapped to c
            if c equals "n":
                set mapped to "\n"
            if c equals "t":
                set mapped to "\t"
            if c equals "r":
                set mapped to "\r"
            if c equals "\"":
                set mapped to "\""
            if c equals "\\":
                set mapped to "\\"
            set out to out + mapped
            set pending to false
            skip next
        if c equals "\\":
            set pending to true
            skip next
        set out to out + c
    give back out

define pack with node, pos:
    set r to empty map
    set key "node" of r to node
    set key "pos" of r to pos
    give back r

define leaf with kind, value:
    set n to empty map
    set key "kind" of n to kind
    set key "value" of n to value
    give back n

define branch with op, left, right:
    set n to empty map
    set key "kind" of n to "bin"
    set key "value" of n to op
    set key "left" of n to left
    set key "right" of n to right
    give back n

define make_call with name, args:
    set n to empty map
    set key "kind" of n to "call"
    set key "value" of n to name
    set key "args" of n to args
    give back n

define is_op_word with t:
    if t equals "and":
        give back true
    if t equals "or":
        give back true
    if t equals "equals":
        give back true
    if t equals "not_equals":
        give back true
    if t equals "less_than":
        give back true
    if t equals "less_than=":
        give back true
    if t equals "greater_than":
        give back true
    if t equals "greater_than=":
        give back true
    if t equals "with":
        give back true
    if t equals "of":
        give back true
    if t equals "in":
        give back true
    if t equals "by":
        give back true
    if t equals "from":
        give back true
    if t equals "to":
        give back true
    give back false

define parse_args with words, pos:
    set args to empty list
    set p to pos
    while p less_than= length of words:
        set t to peek with words, p
        set opw to is_op_word with t
        if opw equals true:
            stop loop
        set r to parse_expr with words, p
        set arg_node to key "node" of r
        add arg_node to args
        set p to key "pos" of r
    set res to empty map
    set key "args" of res to args
    set key "pos" of res to p
    give back res

define parse_primary with words, pos:
    set t to peek with words, pos
    set next to pos + 1
    if t equals "true":
        set n to leaf with "lit", true
        give back pack with n, next
    if t equals "false":
        set n to leaf with "lit", false
        give back pack with n, next
    set quoted to is_quoted with t
    if quoted equals true:
        set v to unquote with t
        set n to leaf with "lit", v
        give back pack with n, next
    set numeric to is_digit_start with t
    if numeric equals true:
        set v to parse json t
        set n to leaf with "lit", v
        give back pack with n, next

    if t equals "empty":
        set what to peek with words, next
        set name to "empty " + what
        set n to make_call with name, empty list
        give back pack with n, next + 1

    if t equals "item" or t equals "key":
        set r1 to parse_primary with words, next
        set p1 to key "pos" of r1
        set r2 to parse_primary with words, p1 + 1
        set args to empty list
        add key "node" of r1 to args
        add key "node" of r2 to args
        set n to make_call with t, args
        give back pack with n, key "pos" of r2

    set of_builtins to ",length,uppercase,lowercase,trim,magnitude,min,max,"
    set search to "," + t + ","
    if of_builtins contains search:
        set after_word to peek with words, next
        if after_word equals "of":
            if t equals "min" or t equals "max":
                set r to parse_args with words, next + 1
                set n to make_call with t, key "args" of r
                give back pack with n, key "pos" of r
            set arg_r to parse_primary with words, next + 1
            set args to empty list
            add key "node" of arg_r to args
            set n to make_call with t, args
            give back pack with n, key "pos" of arg_r

    set direct_builtins to ",round,floor,ceil,abs,sqrt,sin,cos,tan,exp,log,log10,normalize,random decimal,current time,"
    set dsearch to "," + t + ","
    if direct_builtins contains dsearch:
        set arg_r to parse_primary with words, next
        set args to empty list
        add key "node" of arg_r to args
        set n to make_call with t, args
        give back pack with n, key "pos" of arg_r

    if t equals "replace":
        set r1 to parse_expr with words, next
        set p1 to key "pos" of r1
        set r2 to parse_expr with words, p1 + 1
        set p2 to key "pos" of r2
        set r3 to parse_expr with words, p2 + 1
        set args to empty list
        add key "node" of r1 to args
        add key "node" of r2 to args
        add key "node" of r3 to args
        set n to make_call with t, args
        give back pack with n, key "pos" of r3

    if t equals "split" or t equals "join":
        set r1 to parse_expr with words, next
        set p1 to key "pos" of r1
        set r2 to parse_expr with words, p1 + 1
        set args to empty list
        add key "node" of r1 to args
        add key "node" of r2 to args
        set n to make_call with t, args
        give back pack with n, key "pos" of r2

    if t equals "parse" or t equals "to" or t equals "read" or t equals "file":
        set w2 to peek with words, next
        set bname to t + " " + w2
        set r to parse_args with words, next + 1
        set n to make_call with bname, key "args" of r
        give back pack with n, key "pos" of r

    set nxt to peek with words, next
    if nxt equals "with":
        set r to parse_args with words, next + 1
        set n to make_call with t, key "args" of r
        give back pack with n, key "pos" of r

    set n to leaf with "var", t
    give back pack with n, next

define parse_mul with words, pos:
    set left_r to parse_primary with words, pos
    set left to key "node" of left_r
    set p to key "pos" of left_r
    set op to peek with words, p
    while op equals "*" or op equals "/" or op equals "modulo":
        set right_r to parse_primary with words, p + 1
        set right to key "node" of right_r
        set p to key "pos" of right_r
        set left to branch with op, left, right
        set op to peek with words, p
    give back pack with left, p

define parse_add with words, pos:
    set left_r to parse_mul with words, pos
    set left to key "node" of left_r
    set p to key "pos" of left_r
    set op to peek with words, p
    while op equals "+" or op equals "-":
        set right_r to parse_mul with words, p + 1
        set right to key "node" of right_r
        set p to key "pos" of right_r
        set left to branch with op, left, right
        set op to peek with words, p
    give back pack with left, p

define parse_cmp with words, pos:
    set left_r to parse_add with words, pos
    set left to key "node" of left_r
    set p to key "pos" of left_r
    set op to peek with words, p
    set known to false
    if op equals "equals":
        set known to true
    if op equals "not_equals":
        set known to true
    if op equals "less_than":
        set known to true
    if op equals "less_than=":
        set known to true
    if op equals "greater_than":
        set known to true
    if op equals "greater_than=":
        set known to true
    if known equals true:
        set right_r to parse_add with words, p + 1
        set right to key "node" of right_r
        set p to key "pos" of right_r
        set left to branch with op, left, right
    give back pack with left, p

define parse_and with words, pos:
    set left_r to parse_cmp with words, pos
    set left to key "node" of left_r
    set p to key "pos" of left_r
    set op to peek with words, p
    while op equals "and":
        set right_r to parse_cmp with words, p + 1
        set right to key "node" of right_r
        set p to key "pos" of right_r
        set left to branch with op, left, right
        set op to peek with words, p
    give back pack with left, p

define parse_or with words, pos:
    set left_r to parse_and with words, pos
    set left to key "node" of left_r
    set p to key "pos" of left_r
    set op to peek with words, p
    while op equals "or":
        set right_r to parse_and with words, p + 1
        set right to key "node" of right_r
        set p to key "pos" of right_r
        set left to branch with op, left, right
        set op to peek with words, p
    give back pack with left, p

define parse_expr with words, pos:
    set t to peek with words, pos
    if t equals "not":
        set r to parse_or with words, pos + 1
        set n to empty map
        set key "kind" of n to "not"
        set key "value" of n to key "node" of r
        set p to key "pos" of r
        give back pack with n, p
    give back parse_or with words, pos

define emit_op with code, op:
    set ins to empty map
    set key "op" of ins to op
    add ins to code

define emit_arg with code, op, arg:
    set ins to empty map
    set key "op" of ins to op
    set key "arg" of ins to arg
    add ins to code

define emit_call with code, name, count:
    set ins to empty map
    set key "op" of ins to "call"
    set key "arg" of ins to name
    set key "count" of ins to count
    add ins to code

define op_code with op:
    if op equals "+":
        give back "add"
    if op equals "-":
        give back "sub"
    if op equals "*":
        give back "mul"
    if op equals "/":
        give back "div"
    if op equals "modulo":
        give back "mod"
    if op equals "equals":
        give back "eq"
    if op equals "not_equals":
        give back "neq"
    if op equals "less_than":
        give back "lt"
    if op equals "less_than=":
        give back "lte"
    if op equals "greater_than":
        give back "gt"
    if op equals "greater_than=":
        give back "gte"
    if op equals "and":
        give back "and"
    if op equals "or":
        give back "or"
    if op equals "add":
        give back "add"
    if op equals "subtract":
        give back "sub"
    if op equals "multiply":
        give back "mul"
    if op equals "divide":
        give back "div"
    give back op

define emit_node with code, node:
    set kind to key "kind" of node
    set value to key "value" of node
    if kind equals "lit":
        emit_arg with code, "push", value
        give back nothing
    if kind equals "var":
        emit_arg with code, "load", value
        give back nothing
    if kind equals "not":
        emit_node with code, value
        emit_op with code, "not"
        give back nothing
    if kind equals "call":
        set args to key "args" of node
        for each a in args:
            emit_node with code, a
        emit_call with code, value, length of args
        give back nothing
    set left_node to key "left" of node
    set right_node to key "right" of node
    emit_node with code, left_node
    emit_node with code, right_node
    set opcode to op_code with value
    emit_op with code, opcode

define find_word with words, target:
    repeat with i from 1 to length of words:
        set t to item i of words
        if t equals target:
            give back i
    give back 0

define find_to with words:
    repeat with i from 1 to length of words:
        set t to item i of words
        if t equals "to":
            give back i
    give back 0

define patch_arg with code, index, target:
    set ins to item index of code
    set key "arg" of ins to target
    set item index of code to ins

define patch_continues with code, f, base:
    set cs to key "continues" of f
    set target to key "continue" of f
    for each ci in cs:
        set idx to ci - base
        patch_arg with code, idx, target

define patch_breaks with code, f, base, target:
    set brs to key "breaks" of f
    for each bi in brs:
        set idx to bi - base
        patch_arg with code, idx, target

define compile_block with lines, start, base_indent, offset:
    set code to empty list
    set i to start
    set count to length of lines
    while i less_than= count:
        set ln to item i of lines
        set words to key "words" of ln
        if length of words equals 0:
            add 1 to i
            skip next
        set ind to key "indent" of ln
        if ind less_than base_indent:
            stop loop
        if ind greater_than base_indent:
            add 1 to i
            skip next

        set head to item 1 of words

        if head equals "skip":
            set f to current_loop
            set ci to offset + length of code + 1
            emit_arg with code, "jmp", 0
            set cs to key "continues" of f
            add ci to cs
            add 1 to i
            skip next

        if head equals "stop":
            set f to current_loop
            set bi to offset + length of code + 1
            emit_arg with code, "jmp", 0
            set brs to key "breaks" of f
            add bi to brs
            add 1 to i
            skip next

        if head equals "say":
            set p to 2
            set arg_count to 0
            while p less_than= length of words:
                set r to parse_expr with words, p
                set expr_node to key "node" of r
                if arg_count greater_than 0:
                    emit_arg with code, "push", " "
                    emit_op with code, "add"
                emit_node with code, expr_node
                if arg_count greater_than 0:
                    emit_op with code, "add"
                set p to key "pos" of r
                add 1 to arg_count
            emit_op with code, "say"
            add 1 to i
            skip next

        if head equals "set" and item 2 of words not_equals "key":
            set to_at to find_to with words
            set name to item 2 of words
            set p to to_at + 1
            set value_count to 0
            while p less_than= length of words:
                set r to parse_expr with words, p
                emit_node with code, key "node" of r
                add 1 to value_count
                set p to key "pos" of r
            if value_count greater_than 1:
                emit_arg with code, "listn", value_count
            emit_arg with code, "store", name
            add 1 to i
            skip next

        if head equals "set" and item 2 of words equals "key":
            set to_at to find_to with words
            set val_r to parse_expr with words, to_at + 1
            set key_r to parse_expr with words, 3
            set map_r to parse_expr with words, to_at - 1
            emit_node with code, key "node" of val_r
            emit_node with code, key "node" of map_r
            emit_node with code, key "node" of key_r
            emit_op with code, "setkey"
            add 1 to i
            skip next

        if head equals "add" or head equals "subtract" or head equals "multiply" or head equals "divide":
            set name to item 2 of words
            set expr_at to 4
            set opcode to "add"
            set last_at to length of words
            if head equals "add":
                set name to item last_at of words
                set expr_at to 2
                set opcode to "add"
            if head equals "subtract":
                set name to item last_at of words
                set expr_at to 2
                set opcode to "sub"
            if head equals "multiply":
                set opcode to "mul"
            if head equals "divide":
                set opcode to "div"
            set r to parse_expr with words, expr_at
            emit_node with code, key "node" of r
            if opcode equals "add":
                emit_arg with code, "addto", name
            otherwise:
                emit_arg with code, "load", name
                emit_op with code, opcode
                emit_arg with code, "store", name
            add 1 to i
            skip next

        if head equals "give":
            set r to parse_expr with words, 3
            emit_node with code, key "node" of r
            emit_op with code, "ret"
            add 1 to i
            skip next

        if head equals "if":
            set r to parse_expr with words, 2
            emit_node with code, key "node" of r
            set jf_index to length of code + 1
            emit_arg with code, "jf", 0
            set nested to compile_block with lines, i + 1, base_indent + 4, offset + length of code
            set then_code to key "code" of nested
            for each ins in then_code:
                add ins to code
            set next_i to key "next" of nested
            emit_arg with code, "jmp", 0
            set jmp_index to length of code
            patch_arg with code, jf_index, offset + length of code + 1
            set i to next_i
            set after_words to empty list
            if i less_than= count:
                set after_words to key "words" of item i of lines
            if length of after_words greater_than 0:
                set after_head to item 1 of after_words
                if after_head equals "otherwise":
                    set other to compile_block with lines, i + 1, base_indent + 4, offset + length of code
                    set other_code to key "code" of other
                    for each ins in other_code:
                        add ins to code
                    set i to key "next" of other
            patch_arg with code, jmp_index, offset + length of code + 1
            skip next

        if head equals "for":
            add 1 to loop_depth
            set fname to "__f" + loop_depth
            set fname2 to "__n" + loop_depth
            set varname to item 3 of words
            set list_r to parse_expr with words, 5
            emit_node with code, key "node" of list_r
            emit_arg with code, "store", fname2
            emit_arg with code, "push", 0
            emit_arg with code, "store", fname
            set start_at to offset + length of code + 1
            push_loop with start_at
            emit_arg with code, "load", fname
            emit_arg with code, "load", fname2
            emit_call with code, "length", 1
            emit_op with code, "lt"
            set jf_index to length of code + 1
            emit_arg with code, "jf", 0
            emit_arg with code, "load", fname
            emit_arg with code, "push", 1
            emit_op with code, "add"
            emit_arg with code, "load", fname2
            emit_call with code, "item", 2
            emit_arg with code, "store", varname
            set nested to compile_block with lines, i + 1, base_indent + 4, offset + length of code
            set body_code to key "code" of nested
            for each ins in body_code:
                add ins to code
            set f to current_loop
            set key "continue" of f to offset + length of code + 1
            emit_arg with code, "load", fname
            emit_arg with code, "push", 1
            emit_op with code, "add"
            emit_arg with code, "store", fname
            emit_arg with code, "jmp", start_at
            set end_target to offset + length of code + 1
            patch_arg with code, jf_index, end_target
            set f to pop_loop
            patch_continues with code, f, offset
            patch_breaks with code, f, offset, end_target
            set i to key "next" of nested
            subtract 1 from loop_depth
            skip next

        if head equals "while":
            set start_at to offset + length of code + 1
            push_loop with start_at
            set cond_r to parse_expr with words, 2
            emit_node with code, key "node" of cond_r
            set jf_index to length of code + 1
            emit_arg with code, "jf", 0
            set nested to compile_block with lines, i + 1, base_indent + 4, offset + length of code
            set body_code to key "code" of nested
            for each ins in body_code:
                add ins to code
            emit_arg with code, "jmp", start_at
            set end_target to offset + length of code + 1
            patch_arg with code, jf_index, end_target
            set f to pop_loop
            patch_continues with code, f, offset
            patch_breaks with code, f, offset, end_target
            set i to key "next" of nested
            skip next

        if head equals "repeat":
            add 1 to loop_depth
            set cname to "__i" + loop_depth
            set range_form to false
            set second_word to ""
            if length of words greater_than 1:
                set second_word to item 2 of words
            if second_word equals "with":
                set range_form to true
            set from_at to find_word with words, "from"
            set to_at to find_word with words, "to"
            set by_at to find_word with words, "by"
            if by_at equals 0:
                set by_at to find_word with words, "step"
            if range_form equals true:
                set cname to item 3 of words
                set start_r to parse_expr with words, from_at + 1
                emit_node with code, key "node" of start_r
                emit_arg with code, "store", cname
            otherwise:
                emit_arg with code, "push", 0
                emit_arg with code, "store", cname
            set start_at to offset + length of code + 1
            push_loop with start_at
            emit_arg with code, "load", cname
            if range_form equals true:
                set end_r to parse_expr with words, to_at + 1
                emit_node with code, key "node" of end_r
                emit_op with code, "lte"
            otherwise:
                set count_r to parse_expr with words, 2
                emit_node with code, key "node" of count_r
                emit_op with code, "lt"
            set jf_index to length of code + 1
            emit_arg with code, "jf", 0
            set nested to compile_block with lines, i + 1, base_indent + 4, offset + length of code
            set body_code to key "code" of nested
            for each ins in body_code:
                add ins to code
            set f to current_loop
            set key "continue" of f to offset + length of code + 1
            emit_arg with code, "load", cname
            if by_at greater_than 0:
                set step_r to parse_expr with words, by_at + 1
                emit_node with code, key "node" of step_r
            otherwise:
                emit_arg with code, "push", 1
            emit_op with code, "add"
            emit_arg with code, "store", cname
            emit_arg with code, "jmp", start_at
            set end_target to offset + length of code + 1
            patch_arg with code, jf_index, end_target
            set f to pop_loop
            patch_continues with code, f, offset
            patch_breaks with code, f, offset, end_target
            set i to key "next" of nested
            subtract 1 from loop_depth
            skip next

        set second_word to ""
        if length of words greater_than 1:
            set second_word to item 2 of words
        if second_word equals "with":
            set call_r to parse_expr with words, 1
            emit_node with code, key "node" of call_r

        add 1 to i

    set result to empty map
    set key "code" of result to code
    set key "next" of result to i
    give back result

define shift_code with code, delta:
    for each ins in code:
        set op to key "op" of ins
        if op equals "jf" or op equals "jmp":
            set a to key "arg" of ins
            add delta to a
            set key "arg" of ins to a

define function_end with lines, start:
    set j to start + 1
    while j less_than= length of lines:
        set l to item j of lines
        set ind to key "indent" of l
        if ind equals 0:
            stop loop
        add 1 to j
    give back j

define compile_source with source:
    set lines to tokenize_source with source
    set loop_depth to 0
    set loop_stack to empty list
    set main_lines to empty list
    set pending to empty list
    set i to 1
    while i less_than= length of lines:
        set ln to item i of lines
        set ws to key "words" of ln
        set is_def to false
        if length of ws greater_than 0:
            set h to item 1 of ws
            if h equals "define" and key "indent" of ln equals 0:
                set is_def to true
        if is_def equals true:
            set params to empty list
            if length of ws greater_than 3:
                repeat with k from 4 to length of ws:
                    add item k of ws to params
            set info to empty map
            set key "name" of info to item 2 of ws
            set key "params" of info to params
            set key "start" of info to i + 1
            set end_index to function_end with lines, i + 1
            set key "end" of info to end_index - 1
            add info to pending
            set i to end_index
            skip next
        add ln to main_lines
        add 1 to i

    set whole to compile_block with main_lines, 1, 0, 0
    set main_code to key "code" of whole
    set fn_section to empty list
    set defs to empty list
    for each fn in pending:
        set addr to length of main_code + length of fn_section + 1
        set d to empty map
        set key "name" of d to key "name" of fn
        set key "params" of d to key "params" of fn
        set key "addr" of d to addr
        add d to defs
        set fcomp to compile_block with lines, key "start" of fn, 4, length of main_code + length of fn_section + 1
        set fcode to key "code" of fcomp
        for each ins in fcode:
            add ins to fn_section
        emit_op with fn_section, "ret"

    set prologue to empty list
    for each d in defs:
        set ins to empty map
        set key "op" of ins to "funcdef"
        set key "arg" of ins to key "name" of d
        set key "params" of ins to key "params" of d
        set a to key "addr" of d
        add length of defs + 1 to a
        set key "addr" of ins to a
        add ins to prologue

    set shift to length of defs
    shift_code with main_code, shift
    shift_code with fn_section, shift
    emit_arg with main_code, "jmp", 0
    set endjump_index to length of main_code
    set target to length of prologue + length of main_code + length of fn_section + 1
    patch_arg with main_code, endjump_index, target

    set final to empty list
    for each ins in prologue:
        add ins to final
    for each ins in main_code:
        add ins to final
    for each ins in fn_section:
        add ins to final
    give back final
