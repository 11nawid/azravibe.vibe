note: std/priority — priority queue backed by a sorted list of entries
note: use "std/priority"

define entry with value, priority:
    set item to empty map
    set key "value" of item to value
    set key "priority" of item to priority
    give back item

define enqueue with items, value, priority:
    set node to entry with value, priority
    set i to 1
    while i less_than= length of items:
        set current to item i of items
        if key "priority" of current less_than priority:
            set item i of items to node
            set node to current
        set i to i + 1
    add node to items
    give back items

define dequeue with items:
    if length of items equals 0:
        give back null
    set first to item 1 of items
    remove item 1 from items
    give back key "value" of first

define highest with items:
    if length of items equals 0:
        give back null
    give back key "value" of item 1 of items
