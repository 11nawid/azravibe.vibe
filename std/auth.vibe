note: std/auth — signed tokens and password hashing (HMAC-SHA256)
note: use "std/auth"

define sign with payload, secret:
    set encoded to base64url_encode with payload
    set signature to hmac_sha256 with secret, encoded
    give back encoded + "." + signature

define verify with token, secret:
    set parts to split token by "."
    if length of parts not_equals 2:
        give back false
    set expected to hmac_sha256 with secret, item 1 of parts
    if expected equals item 2 of parts:
        give back true
    give back false

define payload_of with token:
    set parts to split token by "."
    if length of parts less_than 1:
        give back null
    give back base64url_decode with item 1 of parts

define hash_password with password, salt:
    give back sha256 with salt + password

define check_password with password, salt, hash:
    if hash_password with password, salt equals hash:
        give back true
    give back false
