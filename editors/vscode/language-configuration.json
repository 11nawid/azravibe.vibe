{
  "comments": {
    "lineComment": "note:",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["\"", "\""],
    ["'", "'"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*.*:\\s*(note:.*|#.*)?$",
    "decreaseIndentPattern": "^\\s*(otherwise|if error as)\\b.*$"
  }
}
