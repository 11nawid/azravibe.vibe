note: 07_error_handling.vibe — division by zero, overflow and domain errors

try:
    say 1 / 0
if error as err:
    say "division:", err

try:
    say sqrt -1
if error as err:
    say "sqrt:", err

try:
    say 9223372036854775807 + 1
if error as err:
    say "overflow:", err

try:
    say 5 modulo 0
if error as err:
    say "modulo:", err

try:
    say asin 2
if error as err:
    say "asin:", err

try:
    say log of 0
if error as err:
    say "log:", err

try:
    say log base 1 of 10
if error as err:
    say "log base:", err

try:
    say normalize vec3 0, 0, 0
if error as err:
    say "normalize:", err

try:
    say exp of 1000
if error as err:
    say "exp overflow:", err
